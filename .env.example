# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Empty DATABASE_URL: in-memory repositories (no database needed to try the HTTP contract).
DATABASE_URL=jdbc:postgresql://localhost:5432/barbersaas
DATABASE_USER=barbershop_app
DATABASE_PASSWORD=
# SPKI PEM public key, one line with \n escapes. barber-saas-infra/scripts/dev-keys.sh generates a development one.
JWT_PUBLIC_KEY=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# identity-auth's internal user read (ADR-014). Empty: creating a barber profile answers 503.
IDENTITY_AUTH_API_URL=http://localhost:8081
# This service's own token (sub: barber-saas-barbershop-api), BARBERSHOP_SERVICE_TOKEN in barber-saas-infra/env/dev.env.
SERVICE_TOKEN=
